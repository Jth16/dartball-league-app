# Copy this file to .env for local development. .env is gitignored — never commit real credentials.

# Used by app.py for local dev / production once migrated to Neon.
# Get this from the Neon dashboard -> Connection Details (use the "pooled connection" string).
# Must use the psycopg2 driver prefix and require SSL:
#   postgresql+psycopg2://<user>:<password>@<host>/<dbname>?sslmode=require
SQLALCHEMY_DATABASE_URI=

# Only needed while running migrate_to_neon.py (same value as above).
TARGET_DATABASE_URI=
